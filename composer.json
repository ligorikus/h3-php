{
    "name": "ligorikus/h3-php",
    "description": "Pure PHP implementation of H3 geospatial indexing system",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.1",
        "vimeo/psalm": "^6.16",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "H3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "H3\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.27"
        }
    },
    "scripts": {
        "test": "phpunit --fail-on-empty-test-suite"
    },
    "keywords": [
        "geospatial",
        "h3",
        "indexing",
        "hexagonal-grid",
        "uber"
    ],
    "support": {
        "issues": "https://github.com/ligorikus/h3-php/issues",
        "source": "https://github.com/ligorikus/h3-php"
    }
}
